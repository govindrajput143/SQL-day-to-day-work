-- Q44. Find employees earning above the average salary of their hire year.
SELECT
    e.emp_name,
    e.department,
    e.salary,
    e.hire_year,
    ROUND((
        SELECT AVG(e2.salary)
        FROM employees e2
        WHERE e2.hire_year = e.hire_year
    ), 2) AS year_avg
FROM employees e
WHERE e.salary > (
    SELECT AVG(e2.salary)
    FROM employees e2
    WHERE e2.hire_year = e.hire_year
)
ORDER BY e.hire_year, e.salary DESC;


-- Q45. Find products with stock below their category average.
SELECT
    p.product_name,
    p.category,
    p.stock_qty,
    ROUND((
        SELECT AVG(p2.stock_qty)
        FROM products p2
        WHERE p2.category = p.category
    ), 2) AS cat_avg_stock
FROM products p
WHERE p.stock_qty < (
    SELECT AVG(p2.stock_qty)
    FROM products p2
    WHERE p2.category = p.category
)
ORDER BY p.category, p.stock_qty ASC;
