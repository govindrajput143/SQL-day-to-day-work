-- DCL (Data Control Language)

DROP USER IF EXISTS 'govind';

CREATE USER 'govind' IDENTIFIED BY 'govind123';

SHOW GRANTS FOR 'go
vind';

-- Give SELECT permission
GRANT SELECT ON newdb.* TO 'govind';

-- Give SELECT and INSERT permissions

GRANT SELECT, INSERT ON newdb.* TO 'govind';

-- Give UPDATE permission on a specific column (example: salary column)
GRANT UPDATE (salary) ON newdb.employees TO 'govind';

-- Give DELETE permission
GRANT DELETE ON newdb.* TO 'govind';

-- Check permissions
SHOW GRANTS FOR 'govind';

-- Revoke DELETE permission
REVOKE DELETE ON newdb.* FROM 'govind';

-- Revoke UPDATE permission
REVOKE UPDATE ON newdb.employees FROM 'govind';

-- Revoke INSERT permission
REVOKE INSERT ON newdb.* FROM 'govind';

-- Revoke SELECT permission
REVOKE SELECT ON newdb.* FROM 'govind';

-- Revoke all privileges
REVOKE ALL PRIVILEGES ON newdb.* FROM 'govind';

-- Check permissions again
SHOW GRANTS FOR 'govind';


